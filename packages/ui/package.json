{
    "name": "@unitifycom/ui",
    "version": "0.2.0",
    "type": "module",
    "license": "MIT",
    "description": "Unitify React UI kit: components, icons, design tokens, fonts and application wrappers",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Unitifycom/ui-kit.git",
        "directory": "packages/ui"
    },
    "homepage": "https://github.com/Unitifycom/ui-kit#readme",
    "bugs": {
        "url": "https://github.com/Unitifycom/ui-kit/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": [
        "**/*.css",
        "**/*.less"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./colors": {
            "types": "./dist/colors/index.d.ts",
            "import": "./dist/colors/index.js"
        },
        "./hooks": {
            "types": "./dist/hooks.d.ts",
            "import": "./dist/hooks.js"
        },
        "./events": {
            "types": "./dist/events.d.ts",
            "import": "./dist/events.js"
        },
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.js"
        },
        "./styles.css": {
            "types": "./dist/styles.d.ts",
            "default": "./dist/styles.css"
        },
        "./style-vars/css": {
            "types": "./dist/styles.d.ts",
            "default": "./dist/tokens/variables.css"
        },
        "./style-vars/less": "./dist/tokens/variables.less",
        "./icons": {
            "types": "./dist/icons/index.d.ts",
            "import": "./dist/icons/index.js"
        },
        "./icons/*": {
            "types": "./dist/icons/components/*.d.ts",
            "import": "./dist/icons/components/*.js"
        },
        "./common": {
            "types": "./dist/common/index.d.ts",
            "import": "./dist/common/index.js"
        },
        "./common/*": {
            "types": "./dist/common/*.d.ts",
            "import": "./dist/common/*.js"
        },
        "./themes": {
            "types": "./dist/common/themes.d.ts",
            "import": "./dist/common/themes.js"
        },
        "./vite": {
            "types": "./dist/common/vite.d.ts",
            "import": "./dist/common/vite.js"
        },
        "./staff.css": {
            "types": "./dist/styles.d.ts",
            "default": "./dist/staff.css"
        },
        "./resident.css": {
            "types": "./dist/styles.d.ts",
            "default": "./dist/resident.css"
        },
        "./fonts.css": {
            "types": "./dist/styles.d.ts",
            "default": "./dist/fonts.css"
        },
        "./antd.less": "./dist/antd.less"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-intl": "^7.1.11"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emoji-mart/data": "^1.2.1",
        "@emoji-mart/react": "^1.1.1",
        "@tanstack/react-table": "^8.1.6",
        "@tiptap/core": "3.31.3",
        "@tiptap/extension-character-count": "3.31.3",
        "@tiptap/extension-code-block": "3.31.3",
        "@tiptap/extension-heading": "3.31.3",
        "@tiptap/extension-image": "3.31.3",
        "@tiptap/extension-link": "3.31.3",
        "@tiptap/extension-list": "3.31.3",
        "@tiptap/extension-placeholder": "3.31.3",
        "@tiptap/extension-table": "3.31.3",
        "@tiptap/extension-table-cell": "3.31.3",
        "@tiptap/extension-table-header": "3.31.3",
        "@tiptap/extension-table-row": "3.31.3",
        "@tiptap/markdown": "3.31.3",
        "@tiptap/pm": "3.31.3",
        "@tiptap/react": "3.31.3",
        "@tiptap/starter-kit": "3.31.3",
        "antd": "4.24.16",
        "classnames": "^2.5.1",
        "emoji-mart": "^5.6.0",
        "react-markdown": "^6",
        "react-phone-input-2": "^2.15.1",
        "remark-gfm": "^1",
        "zod": "^4.0.8",
        "rc-menu": "9.8.4",
        "lodash": "4.17.21",
        "rc-picker": "3.14.7",
        "dayjs": "^1.11.0"
    }
}
