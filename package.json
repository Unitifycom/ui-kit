{
    "name": "unitify-ui-kit",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "bun scripts/build.ts",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings packages scripts tests",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:consumer": "bun scripts/test-consumer.ts",
        "pack": "bun scripts/pack.ts",
        "check": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run pack && bun run test:consumer"
    },
    "devDependencies": {
        "@playwright/test": "1.64.0",
        "@types/bun": "1.4.2",
        "@types/node": "^24.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/lodash": "^4.17.20",
        "@types/less": "^3.0.8",
        "less": "4.2.2",
        "oxlint": "^1.83.0",
        "prettier": "^3.9.8",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-intl": "7.1.14",
        "typescript": "^7.0.2",
        "vite": "^7.0.0",
        "vitest": "^4.1.0",
        "@unitifycom/ui": "workspace:*"
    },
    "trustedDependencies": [
        "esbuild"
    ],
    "overrides": {
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0"
    }
}
